# Wedding invitation env config — copy to .env and customize
# All values are optional; defaults live in src/config.js

# Couple
VITE_GROOM_NAME_KO=박지훈
VITE_GROOM_NAME_EN=Jihoon Park
VITE_BRIDE_NAME_KO=김서연
VITE_BRIDE_NAME_EN=Seoyeon Kim

# Parents (groom)
VITE_GROOM_FATHER=박영수
VITE_GROOM_MOTHER=이미경
# Parents (bride)
VITE_BRIDE_FATHER=김상철
VITE_BRIDE_MOTHER=정혜진

# Date & venue
VITE_WEDDING_DATETIME=2026-10-17T13:00:00+09:00
VITE_VENUE_NAME=그랜드 하얏트 서울 그랜드볼룸
VITE_VENUE_ADDRESS=서울특별시 용산구 소월로 322
VITE_VENUE_LAT=37.541533
VITE_VENUE_LNG=126.984085

# Account info
VITE_GROOM_ACCOUNT=신한은행 110-123-456789 박지훈
VITE_BRIDE_ACCOUNT=국민은행 123-45-6789-012 김서연

# Map keys (later)
VITE_KAKAO_MAP_KEY=
VITE_KAKAO_SHARE_KEY=
VITE_NAVER_MAP_CLIENT_ID=
